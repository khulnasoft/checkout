{
  "name": "khulnasoft-development-engine",
  "version": "1.0.0",
  "description": "AI-Driven Repository Management and Maintenance Platform",
  "type": "module",
  "main": "dist/khulnasoft-engine.js",
  "types": "dist/khulnasoft-engine.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "clean": "rimraf dist",
    "prebuild": "npm run clean",
    "build": "tsc && npm run build:docs",
    "build:prod": "npm run build && ncc build",
    "build:watch": "tsc --watch",
    "build:docs": "ts-node src/misc/generate-docs.ts",
    "format": "prettier --write \"**/*.{ts,js,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,js,json,md}\"",
    "lint": "eslint . --ext .ts,.js --ignore-path .gitignore",
    "lint:fix": "eslint . --ext .ts,.js --fix --ignore-path .gitignore",
    "test": "jest --passWithNoTests",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build && npm run test",
    "start": "node --enable-source-maps dist/khulnasoft-engine.js",
    "dev": "ts-node-dev --respawn --transpile-only src/khulnasoft-engine.ts",
    "engine": "npm start"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KhulnaSoft/checkout.git"
  },
  "keywords": [
    "github",
    "actions",
    "ai",
    "automation",
    "development",
    "maintenance"
  ],
  "author": "KhulnaSoft",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/KhulnaSoft/checkout/issues"
  },
  "homepage": "https://github.com/KhulnaSoft/checkout#readme",
  "dependencies": {
    "@actions/core": "^1.11.1",
    "@actions/exec": "^1.1.1",
    "@actions/github": "^6.0.1",
    "@actions/io": "^1.1.3",
    "@actions/tool-cache": "^2.0.2",
    "openai": "^4.0.0",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^24.7.0",
    "@types/uuid": "^9.0.8",
    "@typescript-eslint/eslint-plugin": "^7.9.0",
    "@typescript-eslint/parser": "^7.9.0",
    "@vercel/ncc": "^0.38.4",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-github": "^4.10.2",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jest": "^28.8.2",
    "eslint-plugin-jsdoc": "^48.2.1",
    "eslint-plugin-prettier": "^5.5.4",
    "eslint-plugin-unused-imports": "^3.1.0",
    "jest": "^29.7.0",
    "jest-circus": "^29.7.0",
    "js-yaml": "^4.1.0",
    "prettier": "^3.6.2",
    "rimraf": "^5.0.5",
    "ts-jest": "^29.4.4",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=16.0.0"
  }
}
